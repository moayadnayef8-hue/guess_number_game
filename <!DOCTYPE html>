<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Chicken Road - إشارات تجريبية</title>

<style>
*{box-sizing:border-box}

body{
  margin:0;
  font-family:Arial,sans-serif;
  background:#111827;
  color:white;
  text-align:center;
}

.game{
  width:min(92%,420px);
  margin:40px auto;
  background:#1f2937;
  padding:25px;
  border-radius:20px;
}

h1{
  margin:0 0 10px;
  font-size:27px;
}

p{
  color:#cbd5e1;
}

.signal{
  margin:25px 0;
  min-height:100px;
  display:flex;
  align-items:center;
  justify-content:center;
  background:#0f172a;
  border-radius:16px;
  font-size:25px;
  font-weight:bold;
}

button{
  width:100%;
  border:0;
  border-radius:14px;
  padding:16px;
  font-size:19px;
  font-weight:bold;
  cursor:pointer;
}

.note{
  margin-top:18px;
  font-size:13px;
  color:#94a3b8;
}
</style>
</head>

<body>

<div class="game">

<h1>🐔 Chicken Road</h1>

<p>مولّد إشارات تجريبية</p>

<div class="signal" id="signal">
اضغط للحصول على إشارة
</div>

<button onclick="getSignal()">
🎯 احصل على إشارة
</button>

<div class="note">
⚠️ هذه إشارات تجريبية عشوائية وليست توقعًا مضمونًا لنتيجة اللعبة.
</div>

</div>

<script>

function getSignal(){

  const signals = [
    "🟢 جرّب الخروج عند 1.50x",
    "🟢 جرّب الخروج عند 1.75x",
    "🟢 جرّب الخروج عند 2.00x",
    "🟡 إشارة حذرة: 1.40x",
    "🟡 إشارة حذرة: 1.60x",
    "🔴 إشارة تجريبية: انتظر الجولة التالية"
  ];

  const random =
    signals[Math.floor(Math.random() * signals.length)];

  document.getElementById("signal").textContent = random;
}

</script>

</body>
</html>
